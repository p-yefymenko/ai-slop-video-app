{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@reelshort/shared": ["../packages/shared/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "drizzle.config.ts"]
}
