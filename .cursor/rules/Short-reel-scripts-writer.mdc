---
description: Write production-ready vertical microdrama ShowScript JSON
globs: content-pipeline/shows/**/script.json,content-pipeline/scripts_input/*.json
alwaysApply: false
---

/**
 * Types from `packages/shared/src/script.ts`.
 * Comments are how to author any vertical microdrama, not a particular plot.
 */

export type ShowCharacter = {
  /**
   * One adult's stable face: age, build, skin, eyes, hair, one distinctive mark.
   * Rank and role must still read in a packed group and in an eye-filling ECU.
   * Scene stills attach the PNG and never receive this text.
   * No wardrobe, pose, expression, action, location, or camera.
   */
  promptBlock: string;
  /**
   * Clay mannequin only. Standing height in meters, and slim / average / broad.
   * Omit to use 1.72m average. This is not the identity portrait.
   */
  proxy?: { heightMeters: number; build: "slim" | "average" | "broad" };
};

/** `[X left/right, Y depth, Z height]` in meters. */
export type Vec3 = [number, number, number];

export type StageLandmark = {
  position: Vec3;
  size: Vec3;
  /**
   * Exact Sketchfab model, `sketchfab:<uid>`. Required. There is no other
   * catalog and no primitive stand-in. The uid is the 32-character id at the
   * end of the model URL. Example: `sketchfab:e63f1154ee0b41f8a797db683526142a`.
   *
   * Needs `SKETCHFAB_TOKEN` in `content-pipeline/.env`. Do not invent a uid.
   * Shortlist with
   * `GET https://api.sketchfab.com/v3/search?type=models&q=<object>&downloadable=true&licenses=cc0,by&count=8&sort_by=-relevance`
   * and header `Authorization: Token <SKETCHFAB_TOKEN>`.
   * User-Agent `reelshort-content-pipeline/1.0`.
   * Keep CC0 and CC-BY. Search rows often omit the slug and say `CC Attribution`;
   * that label is CC-BY. The model endpoint sends slug `by`.
   * Open a thumbnail from the result and keep the uid only when the picture is
   * that one object. A pack, kit, or scene scales every piece into the landmark
   * box. Prefer one mesh and a lower `faceCount`.
   *
   * Verified single meshes, CC-BY and downloadable:
   * citadel `def54040de2749139b69afff756e90bd`,
   * fire ring `8ca31b1d1635406ba2db30e48ecddbdd`,
   * anvil `e63f1154ee0b41f8a797db683526142a`,
   * round plinth `ccaa80d7a16444049f420edd4f4378a4`,
   * one column `7614c26d2b4e41e9810360aca6ecc38e`,
   * lattice pylon `fbf08b82a2ed45068af45e8d90fb7dce`,
   * neck torc `7b60eff248a844eb80d0a5ed462aa551`.
   * Rejected after the thumbnail: modular castle kits, column packs,
   * terrain dioramas, and a holy-well building used as a low fire ring.
   */
  assetId: string;
  /** Pins a prefab and skips the catalog fetch. */
  prefabId?: string;
};

export type StageGeometry = {
  /**
   * Large enough that one ground plane can take a crowd, a body in motion,
   * and a world-scale camera. A tight box forces isolated talking heads.
   * `[width X, depth Y, height Z]`.
   */
  sizeMeters: Vec3;
  landmarks: Record<string, StageLandmark>;
};

export type ShowLocation = {
  /**
   * Materials and light of this world's arena (palace, alley, boardroom, forest).
   * One charged space, reused for wides, groups, and ECUs. Not a viewpoint.
   */
  promptBlock: string;
  spatial: StageGeometry;
};

export type CharacterSpatialKeyframe = {
  timeSeconds: number;
  locationId: string;
  /**
   * Feet. Status stands as a line or cluster facing the outsider.
   * Do not park each speaker on an isolated mark so coverage becomes singles.
   */
  position: Vec3;
  /** `0` faces +Y; positive turns toward +X. */
  bodyYawDegrees: number;
  /** Enemy, ally, or landmark they eye. Reciprocal in a standoff. */
  lookAtId?: string;
  /**
   * Proxy body height only. Strike, fall, and transform live in `videoPrompt`.
   */
  stance: "standing" | "sitting" | "kneeling" | "walking";
  leftHandTargetId?: string;
  rightHandTargetId?: string;
};

export type PropSpatialKeyframe = {
  timeSeconds: number;
  locationId: string;
  position?: Vec3;
  heldByCharacterId?: string;
  heldInHand?: "left" | "right";
};

export type SpatialTimeline = {
  /**
   * One continuous physical crisis. The edit cuts cameras around the cast.
   * People do not teleport to manufacture a close-up.
   */
  durationSeconds: number;
  characterTracks: Record<string, CharacterSpatialKeyframe[]>;
  propTracks: Record<string, PropSpatialKeyframe[]>;
};

export type SpatialCameraKeyframe = {
  timeSeconds: number;
  position: Vec3;
  lookAt: Vec3;
  /**
   * World/empty ~50–70; group ~40–55; single ~20–28; eye or mouth ECU ~12–18.
   */
  verticalFovDegrees: number;
  /** Dutch. Omit or `0` for a level horizon. */
  rollDegrees?: number;
};

export type SpatialCamera = {
  /**
   * Coverage of the same blocking, not a new scene. An episode needs all of:
   * silent world open, character before they speak, proof of power (action/VFX),
   * group or OTS dialogue, ECU on the wounding line, body/hand/foot insert,
   * approach or fight. Heads may leave the frame.
   * One keyframe is locked-off; more than one interpolates.
   */
  keyframes: SpatialCameraKeyframe[];
};

export type ScriptScene = {
  /** Sequential cut number. */
  sceneNumber: number;
  /** Confrontation stays in the arena. Hook may be its exterior. */
  locationId: string;
  /**
   * Cause and effect of this cut, written before prompts.
   * Episode skeleton: hook (world + threat) → pressure (status as a group) →
   * reversal → cliffhanger. Not framing, blocking, or camera.
   */
  storyBeat: string;
  /**
   * Everyone visible, including bodies behind the speaker.
   * Empty for world, VFX, and inserts with no face.
   * First two are Qwen identity Pictures; everyone is in the proxy.
   * A group argument is a group shot, not a rotation of talking singles.
   */
  characterIds: string[];
  /**
   * Who is speaking in this camera, including inside a crowd or two-shot.
   * Omit on silent spectacle. Must be in `characterIds`.
   */
  speakerId?: string;
  /**
   * Shot duration. ~2s for world, inserts, and VFX; 3–6s for one spoken line.
   * Do not also store `durationSeconds`.
   */
  timeRangeSeconds: [number, number];
  /** Required. Prompt-only scenes are forbidden. */
  camera: SpatialCamera;
  /**
   * Wardrobe, expression, and atmosphere for this world's rank and mood.
   * Nameplates and captions are not this field. Omit when location + proxy
   * are enough. Never restate position, facing, eyeline, framing, or set geometry.
   */
  imagePrompt?: string;
  /**
   * One short line and the non-spatial performance (shout, smile, strike).
   * Camera and blocking come from the timeline. Omit on silent shots.
   */
  videoPrompt?: string;
};

export type ShowEpisode = {
  episodeNumber: number;
  /** Episode title, not a shot list. */
  title: string;
  isFree: boolean;
  coinCost: number;
  spatialTimeline: SpatialTimeline;
  /**
   * One crisis, ~0–60s. Cut order: world → face → power proof → group pressure
   * → ECU/reversal → cliffhanger. Do not open on a talking single.
   */
  scenes: ScriptScene[];
};

export type ShowProp = {
  /** Exact Sketchfab model, `sketchfab:<uid>`. Required. Same lookup as `StageLandmark.assetId`. */
  assetId: string;
  prefabId?: string;
  sizeMeters?: Vec3;
};

export type ShowScript = {
  /** Folder name of `content-pipeline/shows/<id>/script.json`. */
  id: string;
  /** Series title. Genre can be anything; coverage grammar stays the same. */
  title: string;
  characters: Record<string, ShowCharacter>;
  locations: Record<string, ShowLocation>;
  /**
   * Every propTracks id. Omit the object when the show has no props.
   * Each prop needs an assetId.
   */
  props?: Record<string, ShowProp>;
  episodes: ShowEpisode[];
};
