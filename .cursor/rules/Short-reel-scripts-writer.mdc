---
description: Write production-ready vertical microdrama ShowScript JSON
globs: content-pipeline/scripts_input/*.json
alwaysApply: false
---

/**
 * Types from `packages/shared/src/script.ts`.
 */

export type ShowCharacter = {
  /**
   * Identity source only. Scene stills attach the generated PNG and never receive this text.
   * No wardrobe, pose, expression, action, location, or camera.
   */
  promptBlock: string;
};

/** `[X left/right, Y depth, Z height]` in meters. */
export type Vec3 = [number, number, number];

export type StageLandmark = {
  kind: "box" | "column" | "pedestal" | "window" | "door" | "seat";
  position: Vec3;
  size: Vec3;
};

export type StageGeometry = {
  sizeMeters: Vec3;
  landmarks: Record<string, StageLandmark>;
};

export type ShowLocation = {
  /** Materials and light. Not a viewpoint. */
  promptBlock: string;
  spatial: StageGeometry;
};

export type CharacterSpatialKeyframe = {
  timeSeconds: number;
  locationId: string;
  /** Feet. */
  position: Vec3;
  /** `0` faces +Y; positive turns toward +X. */
  bodyYawDegrees: number;
  /** Character ID or landmark ID. */
  lookAtId?: string;
  stance: "standing" | "sitting" | "kneeling" | "walking";
  leftHandTargetId?: string;
  rightHandTargetId?: string;
};

export type PropSpatialKeyframe = {
  timeSeconds: number;
  locationId: string;
  position?: Vec3;
  heldByCharacterId?: string;
  heldInHand?: "left" | "right";
};

export type SpatialTimeline = {
  durationSeconds: number;
  characterTracks: Record<string, CharacterSpatialKeyframe[]>;
  propTracks: Record<string, PropSpatialKeyframe[]>;
};

export type SpatialCamera = {
  position: Vec3;
  lookAt: Vec3;
  verticalFovDegrees: number;
  endPosition?: Vec3;
  endLookAt?: Vec3;
};

export type ScriptScene = {
  sceneNumber: number;
  locationId: string;
  /** Cause and effect. Not visuals, blocking, or camera. */
  storyBeat: string;
  /**
   * At most two. Empty for environments and prop inserts.
   * Order is Qwen Picture 1, then Picture 2.
   */
  characterIds: string[];
  /**
   * Omit on silent shots. Exactly one visible person when set.
   * Never set on a two-shot.
   */
  speakerId?: string;
  /**
   * Shot duration is this interval. Required on every shot.
   * Do not also store `durationSeconds`.
   */
  timeRangeSeconds: [number, number];
  /** Required. Prompt-only scenes are forbidden. */
  camera: SpatialCamera;
  /**
   * Wardrobe, expression, and atmosphere only. Omit when the location block
   * and proxy are enough. Never restate position, facing, eyeline, framing,
   * or set geometry.
   */
  imagePrompt?: string;
  /**
   * Spoken line and non-spatial performance. Omit on silent shots.
   * Camera and blocking come from the timeline and start/end frames.
   */
  videoPrompt?: string;
};

export type ShowEpisode = {
  episodeNumber: number;
  title: string;
  isFree: boolean;
  coinCost: number;
  spatialTimeline: SpatialTimeline;
  scenes: ScriptScene[];
};

export type ShowScript = {
  /** Filename stem of `content-pipeline/scripts_input/<id>.json`. */
  id: string;
  title: string;
  characters: Record<string, ShowCharacter>;
  locations: Record<string, ShowLocation>;
  episodes: ShowEpisode[];
};
