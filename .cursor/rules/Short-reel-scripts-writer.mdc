---
description: Write production-ready vertical microdrama ShowScript JSON
globs: content-pipeline/shows/**/script.json,content-pipeline/scripts_input/*.json
alwaysApply: false
---

/**
 * Types from `packages/shared/src/script.ts`.
 * Comments are how to author any vertical microdrama, not a particular plot.
 *
 * The script is a physical world. Every character, landmark, and prop is a
 * mesh the timeline places. You never list who is in a shot: previs renders
 * the world from the camera and checks the script against it. Anyone the
 * camera sees needs a performance; anything you say is on screen (a moving
 * part, a face, a speaker, a sound source) must be visible in the render.
 * Write blocking and cameras first, run `pnpm run content:previs`, and fix
 * what it reports before writing more.
 */

export type ShowCharacter = {
  /** Build and skin. Also how the video prompt points at this person. */
  body: string;
  /**
   * One plain clause per detail: age, hair, clothes, scars. Every still draws
   * the whole person from `body` plus these, from the camera's angle, and keeps
   * only what the shot shows; you never think about what is visible.
   */
  attributes: string[];
  /** Standing height in meters. The mesh is fitted to it. */
  heightMeters: number;
  effects?: Effect[];
};

/** `[X right, Y forward, Z up]` in meters. */
export type Vec3 = [number, number, number];

/**
 * Fire, smoke, steam, sparks, glow: anything that is not a solid surface.
 * Never write it into `appearance`, `body`, or an attribute (validation rejects
 * flame, smoke, glow, and the like there): a mesh would turn it into a solid
 * shape. A fire ring's appearance is the stone ring and its bowl; the flames
 * are an effect. The box hides what is behind it: do not stand a speaker
 * behind a fire. Every still adds the effect as light only inside its box.
 */
export type Effect = {
  appearance: string;
  /** The box it fills, `[width X, depth Y, height Z]`. */
  size: Vec3;
  /** Base center of the box relative to the object's base center, turned with it. */
  offset: Vec3;
};

export type LocationLandmark = {
  /** Base center. */
  position: Vec3;
  /** `[width X, depth Y, height Z]`. The mesh is fitted into this box. */
  size: Vec3;
  /**
   * One solid object, alone: no people, camera, surrounding place, or effects.
   * Qwen draws it, TRELLIS.2 meshes it, and every still that shows any of it
   * draws it alone from that picture. A place seen from far away (a hanging
   * citadel, a ship at sea) is one landmark as large as the location.
   */
  appearance: string;
  effects?: Effect[];
};

export type StageGeometry = {
  /**
   * Large enough that one ground plane can take a crowd, a body in motion,
   * and a world-scale camera. A tight box forces isolated talking heads.
   */
  sizeMeters: Vec3;
  landmarks: Record<string, LocationLandmark>;
};

export type ShowLocation = {
  /**
   * One look shared by everything here. Each object and person is drawn alone,
   * so only these shared words make them belong to one place. `materials` (no
   * effects) is added to every landmark's plate: write a landmark's shape and
   * parts in its `appearance`, not a material that fights this one. `light` is
   * added to every pass of every still here.
   */
  look: { materials: string; light: string };
  /** What fills empty space: sky, ground inside the location, and the horizon beyond, each with a flat color. */
  backdrop: {
    sky: string; skyColor: [number, number, number];
    ground: string; groundColor: [number, number, number];
    surround: string; surroundColor: [number, number, number];
  };
  /**
   * Persistent audio of this place. Required. LTX always invents audio if you
   * omit it. ambience = the bed that is always audible here. space = acoustic
   * character (open air, enclosed hall, reverb). Present tense. Not music
   * unless the place truly has source music.
   */
  soundscape: { ambience: string; space: string };
  spatial: StageGeometry;
};

/**
 * Every character has a track in every episode, starting at 0. Where they are
 * is where they are: if they stand in the court, every camera in the court
 * that sees them shows them. Move them out with `locationId: null`.
 */
export type CharacterSpatialKeyframe = {
  timeSeconds: number;
  /** `null` while off stage. */
  locationId: string | null;
  /**
   * Feet. Required in a location. Status stands as a line or cluster facing the
   * outsider. Do not park each speaker on an isolated mark so coverage becomes singles.
   */
  position?: Vec3;
  /** Required in a location. `0` faces +Y; positive turns toward +X. */
  bodyYawDegrees?: number;
  /** Enemy, ally, landmark, or prop they face. The whole body turns to it. */
  lookAtId?: string;
};

/** Held, placed, or off stage. Every prop has a track starting at 0. */
export type PropSpatialKeyframe =
  | { timeSeconds: number; heldByCharacterId: string; heldInHand: "left" | "right" }
  | { timeSeconds: number; locationId: string; position: Vec3 }
  | { timeSeconds: number; locationId: null };

export type SpatialTimeline = {
  /**
   * One continuous physical crisis. The edit cuts cameras around the cast.
   * People do not teleport to manufacture a close-up.
   */
  durationSeconds: number;
  characterTracks: Record<string, CharacterSpatialKeyframe[]>;
  propTracks: Record<string, PropSpatialKeyframe[]>;
};

export type SpatialCameraKeyframe = {
  timeSeconds: number;
  /** Never inside a mesh. */
  position: Vec3;
  lookAt: Vec3;
  /**
   * World/empty ~50–70; group ~40–55; single ~20–28; eye or mouth ECU ~12–18.
   * A speaker is shot like dialogue: a medium close-up, the face at least about
   * an eighth of the frame height. A full figure from 12 m only smears the mouth.
   */
  verticalFovDegrees: number;
  /** Dutch. Omit or `0` for a level horizon. */
  rollDegrees?: number;
};

export type SpatialCamera = {
  /**
   * Coverage of the same blocking, not a new scene. An episode needs all of:
   * silent world open, character before they speak, proof of power (action/VFX),
   * group or OTS dialogue, ECU on the wounding line, body/hand/foot insert,
   * approach or fight. Heads may leave the frame.
   * One keyframe is locked-off; more than one interpolates.
   * Everything the lens sees is in the shot: a wide of the court shows everyone
   * standing in it, so they all need performances.
   */
  keyframes: SpatialCameraKeyframe[];
};

export type ScriptScene = {
  /** Sequential cut number. */
  sceneNumber: number;
  /** Confrontation stays in the arena. Hook may be its exterior. */
  locationId: string;
  /**
   * Cause and effect of this cut, written before prompts.
   * Episode skeleton: hook (world + threat) → pressure (status as a group) →
   * reversal → cliffhanger. Not framing, blocking, or camera.
   */
  storyBeat: string;
  /**
   * Who is speaking in this camera, including inside a crowd or two-shot.
   * Their face must be visible in the start frame. Omit on silent spectacle.
   */
  speakerId?: string;
  /** ~2s for world, inserts, and VFX; 3–6s for one spoken line. */
  timeRangeSeconds: [number, number];
  /** Required. Prompt-only scenes are forbidden. */
  camera: SpatialCamera;
  /**
   * One entry for everyone the camera sees at any moment of the shot, no more;
   * `{}` when nobody is visible. LTX invents motion it is not given (hands
   * drifting in, touching props), so even stillness is written as an action:
   * a background line "stands motionless, watching her".
   */
  performances: Record<string, ScenePerformance>;
  /** The spoken line. Required exactly when `speakerId` is set. */
  dialogue?: { line: string; delivery: string };
  /**
   * Motion that belongs to no character: fire, smoke, sparks, cloth, light.
   * Camera motion comes from the keyframes.
   */
  motion?: string;
  /**
   * Required sound for every scene. LTX generates audio with every clip.
   * bed = "present" | "faint" (use "faint" when speakerId is set).
   * music = { kind: "none" } or { kind: "described", description }; choose
   * explicitly, there is no default. Distilled CFG 1: positive text only.
   */
  sound: {
    /** At least one. Add to the location bed; never restate or contradict it. */
    events: SoundEvent[];
    bed: "present" | "faint";
    music: { kind: "none" } | { kind: "described"; description: string };
  };
};

export type ScenePerformance = {
  /**
   * Visible motion for the whole take, positive and present tense:
   * "slowly lifts her chin, jaw tightening". Never name a character; LTX only
   * sees the frame. Say "him" / "her" and let lookAtId set the gaze.
   */
  action: string;
  /**
   * Body parts the action moves; `[]` when the action is stillness (a
   * background figure holding still). Each must be on screen at some moment
   * of the shot, because LTX would otherwise invent it.
   * Someone seen from behind has no visible face.
   */
  parts: BodyPart[];
  /**
   * The face in the start frame, as visible cues, not a label: "fear held under
   * defiance: jaw set, eyes glassy but unblinking", not "sad". The still draws
   * it and the clip continues from it, so it must match how the take begins:
   * a speaker, or someone about to exhale, has the lips slightly parted.
   * Keep the mouth close to rest; an open snarl has nowhere to go on a mesh
   * with a closed mouth. Required for the speaker. Only on a face visible in
   * the start frame.
   */
  expression?: string;
};

export type SoundEvent = {
  /** The audible action, present tense. Dialogue is not an event. */
  text: string;
  /**
   * What makes it. Visible in the start frame. A character part (or wardrobe
   * worn on it) must be in that character's performance parts, so the sound
   * has motion behind it. A speaker's face counts as moving.
   */
  source:
    | { characterId: string; part: BodyPart }
    | { landmarkId: string }
    | { propId: string };
};

export type BodyPart =
  | "hair" | "face" | "eyes" | "neck" | "torso" | "arms" | "hands" | "legs" | "feet";

export type ShowEpisode = {
  episodeNumber: number;
  /** Episode title, not a shot list. */
  title: string;
  isFree: boolean;
  coinCost: number;
  spatialTimeline: SpatialTimeline;
  /**
   * One crisis, ~0–60s. Cut order: world → face → power proof → group pressure
   * → ECU/reversal → cliffhanger. Do not open on a talking single.
   */
  scenes: ScriptScene[];
};

export type ShowProp = {
  /**
   * One object, alone, that the timeline moves or hands around. Something a
   * character wears for the whole show is an attribute of theirs, not a prop;
   * writing it as both is an error.
   */
  appearance: string;
  size: Vec3;
  effects?: Effect[];
};

export type ShowScript = {
  /** Folder name of `content-pipeline/shows/<id>/script.json`. */
  id: string;
  /** Series title. Genre can be anything; coverage grammar stays the same. */
  title: string;
  characters: Record<string, ShowCharacter>;
  locations: Record<string, ShowLocation>;
  /** Omit when the show has no props. */
  props?: Record<string, ShowProp>;
  episodes: ShowEpisode[];
};
