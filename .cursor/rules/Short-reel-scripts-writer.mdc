---
description: Write production-ready vertical microdrama ShowScript JSON
globs: content-pipeline/shows/**/script.json,content-pipeline/scripts_input/*.json
alwaysApply: false
---

/**
 * Types from `packages/shared/src/script.ts`.
 * Comments are how to author any vertical microdrama, not a particular plot.
 */

export type ShowCharacter = {
  /**
   * Visible from all sides. Plates, portraits, and every still receive this text.
   * No eye color, scars, tattoos, birthmarks, or other front-only details.
   */
  generalDescription: string;
  /**
   * Front-only details. Plates and portraits always append this. A still appends
   * it only when that person faces the camera, has head-mask pixels, and is at
   * least frontalMinPixelHeight tall.
   */
  frontalDescription?: string;
  /**
   * Standing height in meters, and slim / average / broad. The mesh is fitted to this height.
   * Omit to use 1.72m average. This is not the identity portrait.
   */
  proxy?: { heightMeters: number; build: "slim" | "average" | "broad" };
};

/** `[X left/right, Y depth, Z height]` in meters. */
export type Vec3 = [number, number, number];

export type LocationLandmark = {
  /**
   * Meters: `[X right, Y forward, Z up]`.
   * Author this when people stand in the location. On an empty location, omit it
   * until `pnpm run content:landmarks` fills it from the whole-location mesh.
   */
  position?: Vec3;
  /**
   * `[width X, depth Y, height Z]`. Required when people stand here.
   * The mesh is fitted into this box.
   */
  size?: Vec3;
  /**
   * One object, alone. Qwen draws it and TRELLIS.2 meshes it.
   * No people, camera, or the surrounding place. Required when people stand here.
   */
  appearance?: string;
};

export type StageGeometry = {
  /**
   * Large enough that one ground plane can take a crowd, a body in motion,
   * and a world-scale camera. A tight box forces isolated talking heads.
   * `[width X, depth Y, height Z]`.
   * An empty location is generated as one mesh of this size.
   * A location with people keeps this as the open floor, and each landmark
   * is its own mesh at `size`.
   */
  sizeMeters: Vec3;
  landmarks: Record<string, LocationLandmark>;
};

export type ShowLocation = {
  /**
   * Materials and light of this world's arena (palace, alley, boardroom, forest).
   * One charged space, reused for wides, groups, and ECUs. Not a viewpoint.
   */
  promptBlock: string;
  /**
   * Persistent audio of this place. Required. LTX always invents audio if you
   * omit it. ambience = the bed that is always audible here. space = acoustic
   * character (open air, enclosed hall, reverb). Present tense. Not music
   * unless the place truly has source music.
   */
  soundscape: { ambience: string; space: string };
  spatial: StageGeometry;
};

export type CharacterSpatialKeyframe = {
  timeSeconds: number;
  locationId: string;
  /**
   * Feet. Status stands as a line or cluster facing the outsider.
   * Do not park each speaker on an isolated mark so coverage becomes singles.
   */
  position: Vec3;
  /** `0` faces +Y; positive turns toward +X. */
  bodyYawDegrees: number;
  /** Enemy, ally, or landmark they eye. Reciprocal in a standoff. */
  lookAtId?: string;
  /**
   * Proxy body height only. Strike, fall, and transform live in the scene's `performances`.
   */
  stance: "standing" | "sitting" | "kneeling" | "walking";
  leftHandTargetId?: string;
  rightHandTargetId?: string;
};

export type PropSpatialKeyframe = {
  timeSeconds: number;
  locationId: string;
  position?: Vec3;
  heldByCharacterId?: string;
  heldInHand?: "left" | "right";
};

export type SpatialTimeline = {
  /**
   * One continuous physical crisis. The edit cuts cameras around the cast.
   * People do not teleport to manufacture a close-up.
   */
  durationSeconds: number;
  characterTracks: Record<string, CharacterSpatialKeyframe[]>;
  propTracks: Record<string, PropSpatialKeyframe[]>;
};

export type SpatialCameraKeyframe = {
  timeSeconds: number;
  position: Vec3;
  lookAt: Vec3;
  /**
   * World/empty ~50–70; group ~40–55; single ~20–28; eye or mouth ECU ~12–18.
   */
  verticalFovDegrees: number;
  /** Dutch. Omit or `0` for a level horizon. */
  rollDegrees?: number;
};

export type SpatialCamera = {
  /**
   * Coverage of the same blocking, not a new scene. An episode needs all of:
   * silent world open, character before they speak, proof of power (action/VFX),
   * group or OTS dialogue, ECU on the wounding line, body/hand/foot insert,
   * approach or fight. Heads may leave the frame.
   * One keyframe is locked-off; more than one interpolates.
   */
  keyframes: SpatialCameraKeyframe[];
};

export type ScriptScene = {
  /** Sequential cut number. */
  sceneNumber: number;
  /** Confrontation stays in the arena. Hook may be its exterior. */
  locationId: string;
  /**
   * Cause and effect of this cut, written before prompts.
   * Episode skeleton: hook (world + threat) → pressure (status as a group) →
   * reversal → cliffhanger. Not framing, blocking, or camera.
   */
  storyBeat: string;
  /**
   * Everyone visible, including bodies behind the speaker.
   * Empty for world, VFX, and inserts with no face.
   * First two are Qwen identity Pictures; everyone is in the proxy.
   * A group argument is a group shot, not a rotation of talking singles.
   */
  characterIds: string[];
  /**
   * Who is speaking in this camera, including inside a crowd or two-shot.
   * Omit on silent spectacle. Must be in `characterIds`.
   */
  speakerId?: string;
  /**
   * Shot duration. ~2s for world, inserts, and VFX; 3–6s for one spoken line.
   * Do not also store `durationSeconds`.
   */
  timeRangeSeconds: [number, number];
  /** Required. Prompt-only scenes are forbidden. */
  camera: SpatialCamera;
  /**
   * One entry per characterId, no more; `{}` when no one is on camera.
   * LTX invents motion it is not given (hands drifting in, touching props),
   * so even stillness is written as an action. Previs checks every entry
   * against the render of the start frame.
   */
  performances: Record<string, ScenePerformance>;
  /** The spoken line. Required exactly when `speakerId` is set. */
  dialogue?: { line: string; delivery: string };
  /**
   * Motion that belongs to no character: fire, smoke, sparks, cloth, light.
   * Camera motion comes from the keyframes.
   */
  motion?: string;
  /**
   * Required sound for every scene. LTX generates audio with every clip.
   * bed = "present" | "faint" (use "faint" when speakerId is set).
   * music = { kind: "none" } or { kind: "described", description }; choose
   * explicitly, there is no default. Distilled CFG 1: positive text only.
   */
  sound: {
    /** At least one. Add to the location bed; never restate or contradict it. */
    events: SoundEvent[];
    bed: "present" | "faint";
    music: { kind: "none" } | { kind: "described"; description: string };
  };
  /**
   * Parts that must stay on screen for the whole shot (a foot insert, a hand
   * reaching). Previs fails any playblast frame where one is missing.
   */
  requiresParts?: { characterId: string; part: BodyPart }[];
};

export type ScenePerformance = {
  /**
   * Visible motion for the whole take, positive and present tense:
   * "slowly lifts her chin, jaw tightening". Never name a character; LTX only
   * sees the frame. Say "him" / "her" and let lookAtId set the gaze.
   */
  action: string;
  /**
   * Body parts the action moves, at least one. Previs fails when one is off
   * screen in the start frame, because LTX would invent it mid-shot.
   */
  parts: BodyPart[];
  /**
   * What the face shows, as visible cues, not a label: "fear held under
   * defiance: jaw set, eyes glassy but unblinking", not "sad". Previs requires
   * it exactly when the face is readable in the start frame.
   */
  expression?: string;
};

export type SoundEvent = {
  /** The audible action, present tense. Dialogue is not an event. */
  text: string;
  /**
   * What makes it. Previs fails when the source is not on screen in the start frame.
   * A character part (or wardrobe worn on it) must be in that character's
   * performance parts, so the sound has motion behind it: a breath from a
   * silent face needs "face" in parts and an action that moves the mouth.
   * A speaker's face counts as moving.
   */
  source:
    | { characterId: string; part: BodyPart }
    | { landmarkId: string }
    | { propId: string };
};

export type BodyPart =
  | "hair" | "face" | "eyes" | "neck" | "torso" | "arms" | "hands" | "legs" | "feet";

export type ShowEpisode = {
  episodeNumber: number;
  /** Episode title, not a shot list. */
  title: string;
  isFree: boolean;
  coinCost: number;
  spatialTimeline: SpatialTimeline;
  /**
   * One crisis, ~0–60s. Cut order: world → face → power proof → group pressure
   * → ECU/reversal → cliffhanger. Do not open on a talking single.
   */
  scenes: ScriptScene[];
};

export type ShowProp = {
  /** Held-prop note. Required. It is not part of the location mesh. */
  appearance: string;
  sizeMeters?: Vec3;
};

export type ShowScript = {
  /** Folder name of `content-pipeline/shows/<id>/script.json`. */
  id: string;
  /** Series title. Genre can be anything; coverage grammar stays the same. */
  title: string;
  characters: Record<string, ShowCharacter>;
  locations: Record<string, ShowLocation>;
  /**
   * Every propTracks id. Omit the object when the show has no props.
   * Each prop needs an appearance.
   */
  props?: Record<string, ShowProp>;
  episodes: ShowEpisode[];
};
